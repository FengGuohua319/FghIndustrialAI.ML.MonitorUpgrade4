/*
 * 内容：配置 OPC UA 地址和监控节点
 * 创建时间：[2026-9-25 20:42:46]
 * 创建人：FengGuohua
*/
{
  "Monitoring": {
    "OpcUaEndpoint": "opc.tcp://localhost:4840",
    "MonitoredNodes": [
      "ns=2;s=Temperature",
      "ns=2;s=Pressure",
      "ns=2;s=Current"
    ],
    "IntervalMs": 1000,
    "UseSimulator": true,
    "WindowSize": 30,
    "ZScoreThreshold": 3.0
  },
  "AnomalyDetection": {
    "PvalueHistoryLength": 15,
    "Confidence": 99.9,
    "Side": "TwoSided",
    "WarmupSamples": 15,
    "AlertThrottleSeconds": 30,
    "ShowWarmupProgress": true,
    "WarmupLogInterval": 5,
    "StatsLogInterval": 5 
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
// UseSimulator:true -> 用内置模拟数据源跑，无需PLC;  改成 false -> 连真实OPC UA 服务器
// 初始可以用 99.0 甚至 99.9 跑几天，收集误报率之后再回调。
